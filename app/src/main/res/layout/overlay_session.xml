<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlayRoot"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <View android:id="@+id/scrim" android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="@drawable/scrim"/>

    <com.nour.assistant.ui.GlassCardView android:id="@+id/card"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="4dp" android:layout_marginEnd="4dp"
        android:clickable="true" android:focusable="false">

        <LinearLayout android:id="@+id/cardContent"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="16dp" android:paddingEnd="16dp"
            android:paddingTop="8dp" android:paddingBottom="14dp">

            <!-- منطقة السحب -->
            <FrameLayout android:id="@+id/dragArea" android:layout_width="match_parent" android:layout_height="22dp">
                <View android:layout_width="40dp" android:layout_height="4dp" android:layout_gravity="center"
                    android:background="@drawable/handle"/>
            </FrameLayout>

            <!-- العنوان -->
            <LinearLayout android:id="@+id/header" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:paddingBottom="8dp">
                <com.nour.assistant.ui.NourOrbView android:id="@+id/orb"
                    android:layout_width="34dp" android:layout_height="34dp"
                    android:importantForAccessibility="no"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="6dp" android:text="@string/app_name"
                    android:textColor="#FFFFFF" android:textSize="15sp" android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.02"/>
                <TextView android:id="@+id/status" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:layout_marginStart="10dp"
                    android:textColor="#99FFFFFF" android:textSize="13sp" android:maxLines="1" android:ellipsize="end"/>
                <ImageButton android:id="@+id/btnExpand" android:layout_width="36dp" android:layout_height="36dp"
                    android:background="@drawable/glass_circle" android:src="@drawable/ic_expand"
                    android:contentDescription="@string/open_full"/>
            </LinearLayout>

            <!-- الرد (بيظهر لما النافذة تطول) -->
            <ScrollView android:id="@+id/responseScroll" android:layout_width="match_parent"
                android:layout_height="0dp" android:layout_weight="1"
                android:visibility="gone" android:fadingEdgeLength="24dp" android:requiresFadingEdge="vertical"
                android:overScrollMode="never" android:scrollbars="none">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:paddingTop="4dp" android:paddingBottom="12dp">
                    <TextView android:id="@+id/question" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:layout_gravity="end"
                        android:background="@drawable/glass_chip" android:paddingStart="14dp" android:paddingEnd="14dp"
                        android:paddingTop="8dp" android:paddingBottom="8dp" android:maxWidth="290dp"
                        android:textColor="#E6FFFFFF" android:textSize="14sp"/>
                    <!-- النص الخام (مخفي): للاختبارات وإمكانية الوصول -->
                    <TextView android:id="@+id/answer" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:visibility="gone"
                        android:textColor="#FFFFFF" android:textSize="16sp"/>
                    <com.nour.assistant.ui.ThinkingView android:id="@+id/thinkingPop"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="14dp" android:visibility="gone"/>
                    <com.nour.assistant.ui.MarkdownView android:id="@+id/answerMd"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"/>
                    <TextView android:id="@+id/sourcesBtn" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="12dp" android:visibility="gone" android:clickable="true" android:focusable="true"
                        android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="9dp" android:paddingBottom="9dp"
                        android:textColor="#FFFFFF" android:textSize="13.5sp"/>
                    <LinearLayout android:id="@+id/sourcesBox" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:visibility="gone" android:layout_marginTop="8dp"/>
                </LinearLayout>
            </ScrollView>

            <com.nour.assistant.ui.WaveView android:id="@+id/wave" android:layout_width="match_parent"
                android:layout_height="56dp" android:visibility="gone"/>

            <!-- خانة الكتابة -->
            <!-- شريحة الصفحة المرفقة (زي Gemini) -->
            <LinearLayout android:id="@+id/attachChip" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_gravity="start"
                android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone"
                android:layout_marginBottom="8dp" android:paddingStart="14dp" android:paddingEnd="6dp"
                android:paddingTop="6dp" android:paddingBottom="6dp">
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_globe"
                    android:importantForAccessibility="no"/>
                <TextView android:id="@+id/attachLabel" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="8dp" android:maxWidth="220dp" android:maxLines="1" android:ellipsize="end"
                    android:textColor="#FFFFFF" android:textSize="14sp"/>
                <ImageButton android:id="@+id/attachClose" android:layout_width="32dp" android:layout_height="32dp"
                    android:layout_marginStart="4dp" android:background="@null" android:src="@drawable/ic_close" android:padding="8dp"
                    android:contentDescription="@string/remove"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/inputPill" android:layout_width="match_parent" android:layout_height="52dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/glass_pill" android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingStart="16dp" android:paddingEnd="5dp">
                <EditText android:id="@+id/input" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="match_parent" android:background="@null"
                    android:hint="@string/ask_hint" android:textColorHint="#80FFFFFF" android:textColor="#FFFFFF"
                    android:textSize="15sp" android:imeOptions="actionSend" android:inputType="textCapSentences"
                    android:maxLines="1" android:importantForAutofill="no"/>
                <ImageButton android:id="@+id/btnSend" android:layout_width="42dp" android:layout_height="42dp"
                    android:background="@drawable/glass_circle" android:src="@drawable/ic_send"
                    android:contentDescription="@string/send" android:visibility="gone"/>
                <com.nour.assistant.ui.GradientOrbButton android:id="@+id/btnMic" android:layout_width="44dp"
                    android:layout_height="44dp" android:layout_marginStart="4dp" android:src="@drawable/ic_mic"
                    android:contentDescription="@string/mic"/>
            </LinearLayout>
        </LinearLayout>
    </com.nour.assistant.ui.GlassCardView>

    <!-- أزرار الصفحة: عائمة فوق كرت نور (مش جواه) زي Gemini. بتظهر بس لما تكون في موقع ويب -->
    <LinearLayout android:id="@+id/pagePills" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_gravity="bottom|start"
        android:layout_marginStart="18dp" android:orientation="vertical" android:visibility="gone"
        android:clipChildren="false" android:clipToPadding="false">
        <TextView android:id="@+id/pillAsk" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:drawablePadding="9dp" android:gravity="center_vertical" android:elevation="6dp"
            android:paddingStart="14dp" android:paddingEnd="18dp" android:paddingTop="10dp" android:paddingBottom="10dp"
            android:textColor="#FFFFFF" android:textSize="14sp" android:clickable="true" android:focusable="true"/>
        <TextView android:id="@+id/pillSum" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:drawablePadding="9dp" android:gravity="center_vertical" android:elevation="6dp"
            android:paddingStart="14dp" android:paddingEnd="18dp" android:paddingTop="10dp" android:paddingBottom="10dp"
            android:textColor="#FFFFFF" android:textSize="14sp" android:clickable="true" android:focusable="true"/>
        <TextView android:id="@+id/pillTr" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:drawablePadding="9dp" android:gravity="center_vertical" android:elevation="6dp"
            android:paddingStart="14dp" android:paddingEnd="18dp" android:paddingTop="10dp" android:paddingBottom="10dp"
            android:textColor="#FFFFFF" android:textSize="14sp" android:clickable="true" android:focusable="true"/>
    </LinearLayout>
</FrameLayout>
