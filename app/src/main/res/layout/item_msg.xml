<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp"
    android:paddingTop="7dp" android:paddingBottom="7dp">

    <TextView android:id="@+id/userText"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="end" android:visibility="gone"
        android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="11dp" android:paddingBottom="11dp"
        android:textSize="16sp" android:textIsSelectable="true"/>

    <LinearLayout android:id="@+id/botBox"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:visibility="gone">
        <com.nour.assistant.ui.ThinkingView android:id="@+id/thinking"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:visibility="gone"/>
        <com.nour.assistant.ui.MarkdownView android:id="@+id/md"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <com.nour.assistant.ui.ThinkingView android:id="@+id/status"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:visibility="gone"/>
        <TextView android:id="@+id/sourcesBtn" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:visibility="gone" android:clickable="true" android:focusable="true"
            android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="9dp" android:paddingBottom="9dp"
            android:textSize="13.5sp"/>
    </LinearLayout>
</LinearLayout>
